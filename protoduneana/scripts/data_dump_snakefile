rule merge_plots:
    input:
        tracks=expand(
            '{{input_name}}/tracks/event-{{event}}/tracks-{tags}.pdf',
            tags=config['tracks'],
        ),
        showers=expand(
            '{{input_name}}/showers/event-{{event}}/showers-{tags}.pdf',
            tags=config['showers'],
        ),
        sps=expand(
            '{{input_name}}/sps/event-{{event}}/sps-{tags}.pdf',
            tags=config['spacepoints'],
        ),
        apas=expand(
            '{{input_name}}/wires/event-{{event}}/apa-{apa}-wires-{tag}.pdf',
            tag=config['wires'],
            apa=[i for i in range(1,5)],
        ),
        colls=expand(
            '{{input_name}}/wires/event-{{event}}/collection-wires-{tag}.pdf',
            tag=config['wires'],
        ),
        calos=expand(
            '{{input_name}}/calos/event-{{event}}/calos-{tag}.pdf',
            tag=config['calos'],
        ),
        dedx_calos=expand(
            '{{input_name}}/calos/event-{{event}}/dedx-calos-{tag}.pdf',
            tag=config['calos'],
        ),
        xyz_dedx_calos=expand(
            '{{input_name}}/calos/event-{{event}}/xyz-dedx-calos-{tag}-plane-{plane}.pdf',
            tag=config['calos'],
            plane=[0,1,2],
        )
        # shell:
        #     """
        #     convert {input.tracks} {input.showers} {output}
        #     """
    output:
        f'{{input_name}}/event-{{event}}.pdf'

    run:
        merger = PdfWriter()

        for input_list in input:
            
            # print(input_list)
            merger.append(input_list)
        merger.write(output[0])
        merger.close()

rule all_merged_plots:
    input:
        expand(
            '{input_name}/event-{event}.pdf',
            input_name=inputs,
            event=[i for i in range(config['nevents'])],
        )

rule omnibus:
    input:
        expand(
            '{input_name}/event-{event}.pdf',
            input_name=inputs,
            event=[i for i in range(config['nevents'])],
        )
    output:
        'omnibus.pdf'
    run:
        merger = PdfWriter()
        for input_list in input:
            
            # print(input_list)
            merger.append(input_list)
        merger.write(output[0])
        merger.close()
